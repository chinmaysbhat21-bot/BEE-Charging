
MONGODB_URI=mongodb://127.0.0.1:27017/bee_charging
SESSION_SECRET=replace-with-a-long-random-secret
PORT=5001

# ChargeGuard requires a MongoDB replica set (as do existing booking transactions).
CHARGEGUARD_PROBATION_HOURS=24
# Set a random secret of at least 32 characters on the server only. Never use VITE_ here.
# Empty disables all administrative access. Use HTTPS outside local development.
CHARGEGUARD_ADMIN_TOKEN=


# Set a secret of at least 32 characters for trusted charger completion events.
CHARGING_EVENT_TOKEN=
